# Public Supabase values. Required for authentication.
# On Vercel, set Preview values to the development project and Production values
# to the production project. See docs/environments.md and docs/phase-3.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transactional email (server only). Leave blank to skip sending.
# Test from-address: FQX <beth.t@example.com>
# Production: a verified domain, e.g. FQX <noreply@yourdomain>
RESEND_API_KEY=
EMAIL_FROM=
