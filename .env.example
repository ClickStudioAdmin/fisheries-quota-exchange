# Public Supabase values. Required for authentication.
# On Vercel, set Preview values to the development project and Production values
# to the production project. See docs/environments.md and docs/phase-3.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transactional email (server only). Leave blank to skip sending.
# Test from-address: FQX <beth.t@example.com>
# Production: a verified domain, e.g. FQX <noreply@yourdomain>
RESEND_API_KEY=
EMAIL_FROM=

# Stripe Connect test mode (server secret and webhook secret are not public).
# Use sk_test_ / pk_test_ only. Leave blank to keep Phase 7 simulated purchase.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PandaDoc sandbox (server only). Leave blank to keep Queensland offline pack only.
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_SHARED_KEY=
# Preview only. Dummy @domain recipients so sandbox send is allowed.
# Example: your PandaDoc login, e.g. you@live.com
PANDADOC_SANDBOX_RECIPIENT_EMAIL=

# Server only. Used by the Stripe webhook to mark orders paid. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token for /api/cron/emails (listing expired, auction ending soon, payment reminder).
CRON_SECRET=
